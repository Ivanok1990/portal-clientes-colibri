# Copia este archivo a ".env" y coloca tu propia configuración. El .env NO se sube al repo.

# Conexión a PostgreSQL (Supabase u otro proveedor).
# Recomendado: usa el POOLER DE SESIÓN (puerto 5432). Para un servidor persistente
# da menos latencia que el pooler de transacciones (6543, orientado a serverless).
# En Supabase: botón "Connect" -> Session pooler -> URI
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Conexión usada por Prisma para las migraciones (puede ser la misma que DATABASE_URL).
DIRECT_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción).
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# Origen de datos del portal:
#   postgres (por defecto) -> PostgreSQL vía Prisma
#   odoo                   -> Odoo vía su External API (simulada en el prototipo)
DATA_SOURCE="postgres"

# Configuración del conector de Odoo (solo si DATA_SOURCE=odoo).
# En el prototipo las respuestas están simuladas; con una instancia real estos
# valores apuntan al servidor y al usuario de integración.
ODOO_URL="https://tu-instancia.odoo.com"
ODOO_DB="agencia"
ODOO_USERNAME="portal@agencia.com"
ODOO_API_KEY="api-key-del-usuario-de-integracion"
# ODOO_DEBUG="true"  # registra en consola cada llamada RPC
